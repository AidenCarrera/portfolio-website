# Canonical site URL
# Examples: http://localhost:3000 or https://example.com
SITE_URL=

# Contact form delivery
# All three are required to enable the contact form.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=

# GitHub project data
GITHUB_PAT=
GITHUB_USERNAME=

# Sanity configuration
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_APP_ID=
# Development/testing toggle for verifying fallback behavior without Sanity
SANITY_DISABLED=false

# Spotify track data
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=

# Optional public profile links
LINKEDIN_URL=
INSTAGRAM_URL=
YOUTUBE_URL=
